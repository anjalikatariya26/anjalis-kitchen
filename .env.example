# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://anjali:change-me@localhost:5432/anjalis_kitchen?schema=public
# Production only: separate role for migrations
# DATABASE_MIGRATION_URL=

# --- Authentication (server only; never prefix with NEXT_PUBLIC_) ---
SESSION_COOKIE_NAME=ak_session
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=7
CSRF_SECRET=generate-with-openssl-rand-base64-32
INSECURE_COOKIES=true

# --- Storage ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_BASE_URL=/media
# S3_BUCKET= S3_REGION= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY=

# --- Optional: analytics (public values only) ---
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# --- Optional: error tracking ---
SENTRY_DSN=

# --- Optional: WhatsApp (fallback if business_profile is empty) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=919970599900
